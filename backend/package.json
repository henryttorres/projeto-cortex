{
  "name": "cortex-api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/main.js",
    "dev": "npm run build && node --watch --env-file=.env dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "test": "node --env-file=.env --test test/integration.test.mjs",
    "test:ui": "node --env-file=.env test/browser.mjs",
    "test:communications:ui": "node --env-file=.env test/communications-browser.mjs",
    "test:support": "node --env-file=.env --test test/tickets.test.mjs",
    "test:support:ui": "node --env-file=.env test/tickets-browser.mjs",
    "test:operations": "node --env-file=.env --test test/operations.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "prisma": "6.19.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "effect": "3.20.0",
    "deepmerge-ts": "8.0.2"
  }
}

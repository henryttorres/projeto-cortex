generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  student
  guardian
  teacher
  admin
  support
  supervisor
  coordinator
}
model Account {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String
  active Boolean @default(true)
  roles AccountRole[]
  student Student?
  guardians GuardianLink[]
  teachings Teaching[]
  sessions Session[]
  communications Communication[]
  tickets Ticket[] @relation("Requester")
  assignedTickets Ticket[] @relation("Assignee")
  ticketEntries TicketEntry[]
  supportReadyUntil DateTime?
  resolvedCycles TicketCycle[]
  createdAt DateTime @default(now())
}
model AccountRole {
  accountId String @db.Uuid
  role Role
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@id([accountId, role])
}
model Student {
  id String @id @default(uuid()) @db.Uuid
  name String
  accountId String? @unique @db.Uuid
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  guardians GuardianLink[]
  enrollments Enrollment[]
}
model GuardianLink {
  accountId String @db.Uuid
  studentId String @db.Uuid
  verified Boolean @default(false)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@id([accountId, studentId])
  @@index([studentId])
}
model SchoolClass {
  id String @id @default(uuid()) @db.Uuid
  name String
  period String
  enrollments Enrollment[]
  teachings Teaching[]
  events AgendaEvent[]
  communications CommunicationClass[]
  @@unique([name, period])
}
model Enrollment {
  studentId String @db.Uuid
  classId String @db.Uuid
  active Boolean @default(true)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  @@id([studentId, classId])
  @@index([classId])
}
model Teaching {
  accountId String @db.Uuid
  classId String @db.Uuid
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  @@id([accountId, classId])
  @@index([classId])
}
model AgendaEvent {
  id String @id @default(uuid()) @db.Uuid
  classId String @db.Uuid
  title String
  description String
  location String
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  @@index([classId, startsAt])
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  csrfHash String
  accountId String @db.Uuid
  expiresAt DateTime
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model Communication {
  id String @id @default(uuid()) @db.Uuid
  authorId String @db.Uuid
  title String @db.VarChar(120)
  message String @db.VarChar(5000)
  publishedAt DateTime @default(now()) @db.Timestamptz(3)
  author Account @relation(fields: [authorId], references: [id], onDelete: Restrict)
  classes CommunicationClass[]
  @@index([publishedAt, id])
}
model CommunicationClass {
  communicationId String @db.Uuid
  classId String @db.Uuid
  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  @@id([communicationId, classId])
  @@index([classId])
}
enum TicketStatus {
  open
  in_progress
  resolved
}
enum TicketAction {
  assigned
  opened
  reply
  claim
  resolve
  reopen
}
model Ticket {
  id String @id @default(uuid()) @db.Uuid
  requesterId String @db.Uuid
  assigneeId String? @db.Uuid
  title String @db.VarChar(120)
  description String @db.VarChar(5000)
  status TicketStatus @default(open)
  version Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  requester Account @relation("Requester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee Account? @relation("Assignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  entries TicketEntry[]
  cycles TicketCycle[]
  @@index([requesterId, updatedAt, id])
  @@index([status, updatedAt, id])
}
model TicketEntry {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  authorId String @db.Uuid
  action TicketAction
  message String @db.VarChar(5000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author Account @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([ticketId, createdAt, id])
}
model TicketCycle {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  firstResponseAt DateTime? @db.Timestamptz(3)
  closedAt DateTime? @db.Timestamptz(3)
  resolverId String? @db.Uuid
  firstTargetMinutes Int @default(240)
  resolutionTargetMinutes Int @default(960)
  policy String @default("demo-bahia-9-17-v1")
  score Int?
  ratedAt DateTime? @db.Timestamptz(3)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  resolver Account? @relation(fields: [resolverId], references: [id], onDelete: Restrict)
  @@index([ticketId, startedAt])
  @@index([closedAt, resolverId])
}

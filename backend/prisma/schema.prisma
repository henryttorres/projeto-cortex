generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  student
  guardian
  teacher
  admin
  support
  supervisor
  coordinator
  director
}
enum LessonDraftStatus {
  draft
  published
}
enum LearningGapKind {
  duvida_recorrente
  tentativa_cola
  erro_conceitual
}
model Account {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String
  active Boolean @default(true)
  roles AccountRole[]
  student Student?
  guardians GuardianLink[]
  teachings Teaching[]
  sessions Session[]
  communications Communication[]
  tickets Ticket[] @relation("Requester")
  assignedTickets Ticket[] @relation("Assignee")
  ticketEntries TicketEntry[]
  memberships TeamMember[]
  supportReadyUntil DateTime?
  resolvedCycles TicketCycle[]
  questionAsks TeacherQuestion[] @relation("QuestionAsker")
  questionReplies TeacherQuestionReply[]
  lessonDrafts LessonDraft[] @relation("LessonDraftAuthor")
  reviewedLessonDrafts LessonDraft[] @relation("LessonDraftReviewer")
  reportedLearningGaps LearningGap[] @relation("LearningGapReporter")
  generatedDiagnoses ClassDiagnosis[]
  createdAt DateTime @default(now())
}
model AccountRole {
  accountId String @db.Uuid
  role Role
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@id([accountId, role])
}
model Student {
  id String @id @default(uuid()) @db.Uuid
  name String
  accountId String? @unique @db.Uuid
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  guardians GuardianLink[]
  enrollments Enrollment[]
  questions TeacherQuestion[]
  learningGaps LearningGap[]
}
model GuardianLink {
  accountId String @db.Uuid
  studentId String @db.Uuid
  verified Boolean @default(false)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@id([accountId, studentId])
  @@index([studentId])
}
model SchoolClass {
  id String @id @default(uuid()) @db.Uuid
  name String
  period String
  enrollments Enrollment[]
  teachings Teaching[]
  events AgendaEvent[]
  communications CommunicationClass[]
  subjects Subject[]
  questions TeacherQuestion[]
  lessonDrafts LessonDraft[]
  ragChunks RagDocumentChunk[]
  learningGaps LearningGap[]
  diagnoses ClassDiagnosis[]
  @@unique([name, period])
}
model Enrollment {
  studentId String @db.Uuid
  classId String @db.Uuid
  active Boolean @default(true)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  @@id([studentId, classId])
  @@index([classId])
}
model Teaching {
  accountId String @db.Uuid
  classId String @db.Uuid
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  @@id([accountId, classId])
  @@index([classId])
}
model Subject {
  id String @id @default(uuid()) @db.Uuid
  classId String @db.Uuid
  name String @db.VarChar(120)
  notebookLmUrl String? @db.VarChar(2048)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  questions TeacherQuestion[]
  lessonDrafts LessonDraft[]
  ragChunks RagDocumentChunk[]
  learningGaps LearningGap[]
  diagnoses ClassDiagnosis[]
  @@unique([classId, name])
}
model TeacherQuestion {
  id String @id @default(uuid()) @db.Uuid
  classId String @db.Uuid
  subjectId String? @db.Uuid
  askerId String @db.Uuid
  studentId String @db.Uuid
  question String @db.VarChar(3000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  asker Account @relation("QuestionAsker", fields: [askerId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reply TeacherQuestionReply?
  @@index([classId, createdAt, id])
  @@index([subjectId, createdAt])
}
model TeacherQuestionReply {
  id String @id @default(uuid()) @db.Uuid
  questionId String @unique @db.Uuid
  authorId String @db.Uuid
  answer String @db.VarChar(5000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  question TeacherQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author Account @relation(fields: [authorId], references: [id], onDelete: Restrict)
}
model LessonDraft {
  id String @id @default(uuid()) @db.Uuid
  classId String @db.Uuid
  subjectId String? @db.Uuid
  authorId String @db.Uuid
  title String @db.VarChar(160)
  objectives String @db.VarChar(5000)
  materials String @db.VarChar(5000)
  activities String @db.VarChar(10000)
  assessment String @db.VarChar(5000)
  status LessonDraftStatus @default(draft)
  reviewedBy String? @db.Uuid
  reviewedAt DateTime? @db.Timestamptz(3)
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  author Account @relation("LessonDraftAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer Account? @relation("LessonDraftReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  @@index([classId, status, createdAt])
  @@index([subjectId])
}
model RagDocumentChunk {
  id String @id @default(uuid()) @db.Uuid
  classId String @db.Uuid
  subjectId String @db.Uuid
  title String @db.VarChar(160)
  sourceName String @db.VarChar(255)
  chunkIndex Int
  content String @db.Text
  embeddingJson Json? @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@index([classId, subjectId, createdAt])
  @@index([subjectId, chunkIndex])
}
model LearningGap {
  id String @id @default(uuid()) @db.Uuid
  classId String @db.Uuid
  subjectId String? @db.Uuid
  studentId String? @db.Uuid
  reportedById String @db.Uuid
  kind LearningGapKind
  description String @db.VarChar(3000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  reportedBy Account @relation("LearningGapReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  @@index([classId, subjectId, kind, createdAt])
  @@index([studentId, createdAt])
}
model ClassDiagnosis {
  id String @id @default(uuid()) @db.Uuid
  classId String @db.Uuid
  subjectId String? @db.Uuid
  generatedById String @db.Uuid
  totalGaps Int
  summary String @db.VarChar(5000)
  recommendations String @db.VarChar(5000)
  indicators Json @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  generatedBy Account @relation(fields: [generatedById], references: [id], onDelete: Restrict)
  @@index([classId, createdAt])
  @@index([subjectId])
}
model AgendaEvent {
  id String @id @default(uuid()) @db.Uuid
  classId String @db.Uuid
  title String
  description String
  location String
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  @@index([classId, startsAt])
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  csrfHash String
  accountId String @db.Uuid
  expiresAt DateTime
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model Communication {
  id String @id @default(uuid()) @db.Uuid
  authorId String @db.Uuid
  title String @db.VarChar(120)
  message String @db.VarChar(5000)
  publishedAt DateTime @default(now()) @db.Timestamptz(3)
  author Account @relation(fields: [authorId], references: [id], onDelete: Restrict)
  classes CommunicationClass[]
  @@index([publishedAt, id])
}
model CommunicationClass {
  communicationId String @db.Uuid
  classId String @db.Uuid
  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  @@id([communicationId, classId])
  @@index([classId])
}
enum TicketStatus {
  open
  in_progress
  resolved
}
enum TicketAction {
  transfer
  escalate
  decision
  registration
  assigned
  opened
  reply
  claim
  resolve
  reopen
}
model Ticket {
  teamId String? @db.Uuid
  team SupportTeam? @relation(fields: [teamId], references: [id], onDelete: Restrict)
  escalationRole Role?
  escalationDueAt DateTime? @db.Timestamptz(3)
  escalationPending Boolean @default(false)
  registeredStudentId String? @unique @db.Uuid
  id String @id @default(uuid()) @db.Uuid
  requesterId String @db.Uuid
  assigneeId String? @db.Uuid
  title String @db.VarChar(120)
  description String @db.VarChar(5000)
  status TicketStatus @default(open)
  version Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  requester Account @relation("Requester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee Account? @relation("Assignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  entries TicketEntry[]
  cycles TicketCycle[]
  @@index([requesterId, updatedAt, id])
  @@index([status, updatedAt, id])
}
model TicketEntry {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  authorId String @db.Uuid
  action TicketAction
  message String @db.VarChar(5000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author Account @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([ticketId, createdAt, id])
}
model TicketCycle {
  teamId String? @db.Uuid
  team SupportTeam? @relation(fields: [teamId], references: [id], onDelete: Restrict)
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  firstResponseAt DateTime? @db.Timestamptz(3)
  closedAt DateTime? @db.Timestamptz(3)
  resolverId String? @db.Uuid
  firstTargetMinutes Int @default(240)
  resolutionTargetMinutes Int @default(960)
  policy String @default("demo-bahia-9-17-v1")
  score Int?
  ratedAt DateTime? @db.Timestamptz(3)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  resolver Account? @relation(fields: [resolverId], references: [id], onDelete: Restrict)
  @@index([ticketId, startedAt])
  @@index([closedAt, resolverId])
}

model SupportTeam {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)
  active Boolean @default(true)
  isDefault Boolean @default(false)
  members TeamMember[]
  tickets Ticket[]
  cycles TicketCycle[]
}
model TeamMember {
  teamId String @db.Uuid
  accountId String @db.Uuid
  role Role
  team SupportTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@id([teamId, accountId])
  @@index([accountId])
}
